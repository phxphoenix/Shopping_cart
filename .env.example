# Konfiguracja środowiskowa Vercel + Neon Postgres (v3.0)

# Neon Serverless Postgres Connection String (z sslmode=require)
DATABASE_URL=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Hasło administratora do panelu zarządczego (/api/admin/*)
ADMIN_PASSWORD=zmien-mnie-na-silne-haslo

# Klucz HMAC-SHA256 do podpisywania ciasteczek sesyjnych HttpOnly (min. 32 znaki)
ADMIN_SESSION_SECRET=losowy-sekret-minimum-32-znaki-do-podpisywania-sesji

# Opcjonalna ścieżka bazowa dla statycznych buildów (domyślnie '/')
VITE_BASE_PATH=/
